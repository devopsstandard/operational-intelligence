# GCP Infrastructure Configuration
# Replace with your actual GCP Project ID and Region
GCP_PROJECT_ID="your-gcp-project-id"
GCP_PROJECT_NUMBER="123456789012"
GCP_REGION="us-central1"

# GitHub Repository for WIF & GitOps (format: owner/repo)
GITHUB_REPO="your-username/argo-cd-deployment"

# Environment targeting (dev or prod)
ENV_NAME="dev"
